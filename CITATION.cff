    given-names: Nikita L.
    affiliation: Moscow State University
    email: nikitapol@fbb.msu.ru
version: "1.0.0"
license: MIT
repository-code: "https://github.com/doctawho42/PAIEC"
keywords:
  - predictive evaluation
  - item response theory
  - Brier score
  - cold start
  - PAIEC
